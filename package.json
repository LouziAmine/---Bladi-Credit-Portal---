{
  "name": "bladi-credit-portal",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "postbuild": "node tools/purge-css.mjs",
    "watch": "ng build --watch --configuration development",
    "preview": "npm run build && node tools/preview-server.mjs",
    "test": "ng test",
    "test:coverage": "ng test --coverage",
    "test:e2e": "playwright test",
    "test:perf": "lhci autorun",
    "test:security:sca": "audit-ci --config audit-ci.jsonc",
    "test:security:sast": "npm exec eslint -- \"**/*.ts\"",
    "test:security:dast": "./security/run-zap-scan.sh",
    "lint": "npm exec eslint \"**/*.ts\" \"**/*.html\""
  },
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@fontsource/poppins": "^5.3.0",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^22.0.0",
    "@angular-eslint/eslint-plugin": "^22.0.0",
    "@angular-eslint/eslint-plugin-template": "^22.0.0",
    "@angular-eslint/template-parser": "^22.0.0",
    "@angular/build": "^22.0.3",
    "@angular/cli": "^22.0.3",
    "@angular/compiler-cli": "^22.0.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.0",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "@vitest/coverage-v8": "^4.1.9",
    "angular-eslint": "^22.0.0",
    "audit-ci": "^7.1.0",
    "compression": "^1.8.1",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-security": "^4.0.1",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "prettier-eslint": "^17.1.0",
    "purgecss": "^8.0.0",
    "sharp": "^0.35.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.61.1",
    "vitest": "^4.0.8"
  }
}
